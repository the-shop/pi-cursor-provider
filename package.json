{
  "name": "pi-cursor-provider",
  "version": "0.1.0",
  "description": "Cursor subscription models for the pi coding agent through the cursor-agent CLI.",
  "keywords": [
    "pi-package",
    "pi",
    "pi-coding-agent",
    "cursor",
    "cursor-agent",
    "provider"
  ],
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/the-shop/pi-cursor-provider.git"
  },
  "engines": {
    "node": ">=22.6.0"
  },
  "scripts": {
    "test": "node tools/secret-scan.mjs && node --experimental-strip-types tools/unit.ts && node --experimental-strip-types --import=./tools/pi-ai-test-loader.mjs tools/registration.ts",
    "test:e2e": "node --experimental-strip-types --import=./tools/pi-ai-test-loader.mjs tools/e2e.ts",
    "test:e2e:real": "node --experimental-strip-types --import=./tools/pi-ai-test-loader.mjs tools/e2e-real.ts",
    "secret-scan": "node tools/secret-scan.mjs"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-ai": {
      "optional": true
    },
    "@earendil-works/pi-coding-agent": {
      "optional": true
    }
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  }
}
